# Copy this to .env and fill in your values (never commit .env to git)

# PostgreSQL connection string (Render provides this automatically in production)
DATABASE_URL=postgresql://user:password@host:5432/expenses

# Your Anthropic API key for AI insights
# Get one at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Server port (Render sets this automatically)
PORT=3000
